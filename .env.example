# API 服务默认仅监听本机。生产构建后 npm start 同时提供 Dashboard 和 API。
PORT=3001
HOST=127.0.0.1
# 网站公开接口独立于官方网关；实验性，访问受限会明确报错。
PUBLIC_DATA_ENABLED=true
# 可选：OpenAI 兼容 Chat Completions API。只在服务端读取；不填则使用可追溯的规则分析。
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=
# 单次模型请求的总时限（毫秒），默认 15 分钟。带思考过程的模型可能需要数分钟。
AI_TIMEOUT_MS=900000
# 执行 npm run setup:live 可安全生成本地网关配置与随机密钥，保留已有 AI 配置。
# 完整接入步骤见 docs/live-gateway.md。不开启时不影响 Demo / Import。
LIVE_DATA_URL=
LIVE_DATA_KEY=
# 内置网关填 bilibili-official；外部已授权网关保留空值并设置下面的授权声明。
LIVE_DATA_PROVIDER=
LIVE_DATA_AUTHORIZED=false
LIVE_GATEWAY_ENABLED=false
LIVE_GATEWAY_PORT=3003
BILIBILI_CLIENT_ID=
BILIBILI_CLIENT_SECRET=
BILIBILI_REDIRECT_URI=http://127.0.0.1:3001/api/live/callback
BILIBILI_MAX_VIDEOS=50
BILIBILI_REQUEST_INTERVAL_MS=1000
